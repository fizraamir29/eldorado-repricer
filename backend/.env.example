# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgresql+asyncpg://repricer:repricer@db:5432/repricer

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Any long random string
JWT_SECRET=

# Fill in once the client provides Eldorado's official Seller API base URL
MARKETPLACE_BASE_URL=https://api.eldorado.gg

# Once you have the real Seller API docs, set these two — no code change needed:
#   header name is usually "Authorization" or "X-API-Key"
#   scheme is usually "Bearer" (leave blank "" if the API wants the raw key with no prefix)
MARKETPLACE_AUTH_HEADER_NAME=Authorization
MARKETPLACE_AUTH_SCHEME=Bearer

DEFAULT_CHECK_INTERVAL_MINUTES=5

# "development" = tables auto-created on startup (convenient for local testing)
# "production" = you must run `alembic upgrade head` yourself before starting the app
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" for JSON-formatted logs (useful for log aggregation services)
LOG_JSON=false
